# ── Backend API URL ───────────────────────────────────────────────────────────
# Local dev: leave empty → Vite proxy forwards /api/* to localhost:5000
# Production (Vercel): set to your Render backend URL
VITE_API_URL=https://skillsync-1-90fy.onrender.com/api

# ── AI Keys (all free-tier) ───────────────────────────────────────────────────
# Groq — free at https://console.groq.com
# Used for: JD analysis, resume generation, bullet quality scoring
VITE_GROQ_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Google Gemini — free at https://aistudio.google.com
# Used for: bullet improvements, skill suggestions, ATS keyword recommendations
VITE_GEMINI_KEY=AIzaSyxxxxxxxxxxxxxx

# Hugging Face — free at https://huggingface.co/settings/tokens
# Used for: keyword extraction (stage 1 of AI analysis pipeline)
VITE_HUGGINGFACE_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# ── Google Sign-In ───────────────────────────────────────────────────────────
# Google OAuth Client ID — from https://console.cloud.google.com
# Optional: only needed if Google Sign-In button is used
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
